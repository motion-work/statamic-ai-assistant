# Statamic AI Assistant — environment variables
# Copy the relevant blocks into the host Laravel app's .env file.

# ─────────────────────────────────────────────────────────────────────────────
# Required: pick a provider and supply its credentials
# ─────────────────────────────────────────────────────────────────────────────

# auto (default): openrouter once OPENROUTER_API_KEY is set, otherwise infomaniak.
# Or name one: openrouter (one API for every model) / infomaniak (Swiss hosting).
STATAMIC_AI_ASSISTANT_PROVIDER_NAME=auto

# OpenRouter — create one key per site with a spending limit at openrouter.ai.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://eu.openrouter.ai/api/v1   # EU in-region routing (Business/Enterprise plans only)
# Override the models per task (comma-separated, first answers, the rest are fallbacks):
# OPENROUTER_AGENT_MODELS=
# OPENROUTER_LIGHT_MODELS=
# OPENROUTER_FIELD_MODELS=
# OPENROUTER_TRANSLATE_MODELS=
# OPENROUTER_VISION_MODELS=
# OPENROUTER_DATA_COLLECTION=deny                        # only providers that don't store or train on prompts
# OPENROUTER_ZDR=false                                   # true = zero-data-retention endpoints only
# OPENROUTER_STRUCTURED_OUTPUTS=true
# OPENROUTER_PROMPT_CACHING=true

# Infomaniak — used when STATAMIC_AI_ASSISTANT_PROVIDER_NAME=infomaniak, or on auto without an OpenRouter key.
# Find your product id in the Infomaniak dashboard (Computing → AI Tools).
INFOMANIAK_PRODUCT_ID=
INFOMANIAK_API_TOKEN=
# INFOMANIAK_MODEL=qwen3
# INFOMANIAK_MODEL_FAST=Qwen/Qwen3.8-27B-FP8
# Reasoning models think before answering; quick tasks (Ai Text, Bard, alt text) skip it by default
# STATAMIC_AI_ASSISTANT_QUICK_TASKS_WITHOUT_THINKING=true

# https://jina.ai/reader — sent as Authorization: Bearer {key}.
# Without a key the URL fetch tool will be rate-limited.
STATAMIC_AI_ASSISTANT_JINA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Figma OAuth (design context for the entry generator)
# ─────────────────────────────────────────────────────────────────────────────
# Create an app at https://www.figma.com/developers/apps and register the
# redirect URL shown in the AI agent settings page.
# STATAMIC_AI_ASSISTANT_FIGMA_OAUTH_CLIENT_ID=
# STATAMIC_AI_ASSISTANT_FIGMA_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Optional: feature flags
# ─────────────────────────────────────────────────────────────────────────────
# STATAMIC_AI_ASSISTANT_TRANSLATIONS=true            # per-entry + per-field translate
# STATAMIC_AI_ASSISTANT_BULK_TRANSLATIONS=true       # CP "Bulk translations" tool
# DEEPL_API_KEY=                                     # without it, translations run on the AI model
# STATAMIC_AI_ASSISTANT_TRANSLATION_LLM_FALLBACK=true # false = require DeepL
# STATAMIC_AI_ASSISTANT_ENTRY_GENERATOR=true         # master switch: AI agent generator (off = disabled for everyone, incl. super admins)
# ENABLE_AGENT_FOR_EDITORS=true                      # false = hide the agent from non-super editors only (super admins always keep access)
# EDITOR_LIMIT_ENTRIES=true                          # non-super users: 1 entry per request (super users unlimited)

# ─────────────────────────────────────────────────────────────────────────────
# Advanced: tuning (defaults are sensible — only set if you hit a limit)
# ─────────────────────────────────────────────────────────────────────────────
# HTTP timeouts (seconds)
# STATAMIC_AI_ASSISTANT_INFOMANIAK_HTTP_TIMEOUT=600
# OPENROUTER_HTTP_TIMEOUT=180
# STATAMIC_AI_ASSISTANT_JINA_TIMEOUT=120

# Queued entry generation (requires QUEUE_CONNECTION != sync)
# STATAMIC_AI_ASSISTANT_ENTRY_GENERATOR_QUEUE=default
# STATAMIC_AI_ASSISTANT_ENTRY_GENERATOR_JOB_TIMEOUT=300
# STATAMIC_AI_ASSISTANT_ENTRY_GENERATOR_JOB_TRIES=2

# Planner output ceiling (raise if listings get truncated to a single entry)
# STATAMIC_AI_ASSISTANT_PLANNER_MAX_OUTPUT_TOKENS=12000

# Remote image fetch (save_remote_image tool)
# STATAMIC_AI_ASSISTANT_IMAGE_FETCH_ASSET_CONTAINER=