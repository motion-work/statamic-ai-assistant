{
    "name": "motion-work/statamic-ai-assistant",
    "description": "Statamic 6 addon: AI text generation and refactoring in the Control Panel (Ai Text, Bard, DeepL translations). Requires statamic/cms ^6.5.",
    "keywords": ["statamic", "statamic-6", "ai", "bard", "deepl"],
    "type": "statamic-addon",
    "license": "MIT",
    "homepage": "https://github.com/motion-work/statamic-ai-assistant",
    "authors": [
        {
            "name": "Motion Work",
            "homepage": "https://github.com/motion-work"
        }
    ],
    "support": {
        "issues": "https://github.com/motion-work/statamic-ai-assistant/issues",
        "source": "https://github.com/motion-work/statamic-ai-assistant"
    },
    "autoload": {
        "psr-4": {
            "MotionWork\\StatamicAiAssistant\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MotionWork\\StatamicAiAssistant\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^6.5",
        "deeplcom/deepl-php": "^1.9",
        "smalot/pdfparser": "^2.0",
        "league/html-to-markdown": "^5.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "heyosseus/sloppy": "^1.8",
        "rector/rector": "^2.8",
        "laravel/pint": "^1.32"
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": [
            "pint --test",
            "@php -d memory_limit=1G vendor/bin/sloppy"
        ],
        "fix": [
            "@php -d memory_limit=1G vendor/bin/sloppy fix"
        ],
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        },
        "statamic": {
            "name": "Statamic AI Assistant",
            "description": "AI-assisted writing and DeepL translations for Statamic 6.5+ (custom fieldtypes and Bard)."
        },
        "laravel": {
            "providers": [
                "MotionWork\\StatamicAiAssistant\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite (rewrites tests/__fixtures__; restore before committing).",
        "format": "Format PHP with Pint.",
        "lint": "Check formatting (Pint) and new code-quality findings (Sloppy, against .sloppy-baseline.json).",
        "fix": "Apply Sloppy's automated fixes (Rector, then Pint on the rewritten files).",
        "check": "lint + test, as CI runs them."
    }
}
